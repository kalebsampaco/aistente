# Configuración del Asistente Virtual

# Ollama Configuration
OLLAMA_HOST=http://ollama:11434

# AWS S3 / MinIO Configuration
# Para MinIO local (desarrollo):
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://minio:9000
AWS_DEFAULT_REGION=us-east-1

# Para AWS S3 real (producción):
# AWS_ACCESS_KEY_ID=tu_access_key_real
# AWS_SECRET_ACCESS_KEY=tu_secret_key_real
# AWS_ENDPOINT_URL=  # Dejar vacío o comentar para usar AWS S3 real
# AWS_DEFAULT_REGION=us-east-1

